# Yalnızca örnek: uygulama bu dosyayı otomatik okumaz.
# Anahtarları kendi terminal/sistem ortamınıza tanımlayın; bu dosyaya gerçek sır yazmayın.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
# API istemiyorsanız LLM_PROVIDER=local kullanıp Ollama/Gemma modelini ayrıca kurun.
# Otomasyon için scripts/setup_local_automation.py kullanın; token yerelde üretilir.
